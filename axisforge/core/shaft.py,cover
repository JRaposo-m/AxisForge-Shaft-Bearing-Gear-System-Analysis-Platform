> """
> AxisForge — Shaft Geometry Model
  
> Defines the geometric primitives for shaft modelling:
>   - Shoulder : transition geometry between adjacent sections
>   - ShaftSection : single uniform cylindrical segment
>   - Shaft : ordered collection of ShaftSection objects
  
> Design rules:
>   - All geometric properties are @property (never stored as attributes).
>   - All units are mm (lengths) and mm⁴ (area moments).
>   - Validation occurs in __post_init__; never silently accept invalid geometry.
>   - No external library imports beyond numpy and stdlib.
  
> References:
>   - Shigley §7-1 (shaft geometry conventions)
>   - Peterson §1 (stress raisers at geometric discontinuities)
> """
  
> from __future__ import annotations
  
> import math
> from dataclasses import dataclass, field
> from typing import Optional
  
> from config import TOL_GEOMETRY_mm
  
  
  # ---------------------------------------------------------------------------
  # Shoulder
  # ---------------------------------------------------------------------------
  
> @dataclass
> class Shoulder:
>     """
>     Geometric transition between two adjacent shaft sections (step change).
  
>     The shoulder describes the geometry of the fillet at a diameter step.
>     It is not a section itself and does not contribute to shaft length.
  
>     Attributes
>     ----------
>     fillet_radius : float
>         Fillet radius r [mm] at the root of the step.
>     diameter_large : float
>         Larger diameter D [mm] (the bigger section side).
>     diameter_small : float
>         Smaller diameter d [mm] (the smaller section side).
  
>     Derived ratios (for Peterson interpolation):
>         r/d = fillet_radius / diameter_small
>         D/d = diameter_large / diameter_small
  
>     Constraints (from Peterson):
>         fillet_radius > 0
>         diameter_large > diameter_small
>         fillet_radius ≤ (D - d) / 2  (fillet cannot exceed step height)
>     """
>     fillet_radius: float
>     diameter_large: float
>     diameter_small: float
  
>     def __post_init__(self) -> None:
>         if self.fillet_radius <= 0:
>             raise ValueError(
>                 f"fillet_radius must be > 0, got {self.fillet_radius}"
>             )
>         if self.diameter_large <= self.diameter_small:
>             raise ValueError(
>                 f"diameter_large ({self.diameter_large}) must be > "
>                 f"diameter_small ({self.diameter_small})"
>             )
>         step_height = (self.diameter_large - self.diameter_small) / 2.0
>         if self.fillet_radius > step_height + TOL_GEOMETRY_mm:
>             raise ValueError(
>                 f"fillet_radius ({self.fillet_radius} mm) cannot exceed "
>                 f"step height ({step_height:.4f} mm)"
>             )
  
>     @property
>     def r_over_d(self) -> float:
>         """r/d — primary Peterson interpolation ratio."""
>         return self.fillet_radius / self.diameter_small
  
>     @property
>     def D_over_d(self) -> float:
>         """D/d — secondary Peterson interpolation ratio."""
>         return self.diameter_large / self.diameter_small
  
>     def validate(self) -> list[str]:
>         """Return list of geometry errors (empty if valid)."""
>         errors: list[str] = []
>         if self.fillet_radius <= 0:
!             errors.append(f"fillet_radius must be > 0, got {self.fillet_radius}")
>         if self.diameter_large <= self.diameter_small:
!             errors.append(
!                 f"diameter_large ({self.diameter_large}) must exceed "
!                 f"diameter_small ({self.diameter_small})"
!             )
>         return errors
  
  
  # ---------------------------------------------------------------------------
  # ShaftSection
  # ---------------------------------------------------------------------------
  
> @dataclass
> class ShaftSection:
>     """
>     Single uniform cylindrical segment of a shaft.
  
>     The section models a stepped shaft element with constant inner and
>     outer diameters over its axial length. Shoulder transitions at the
>     ends are separate objects (not part of the length budget).
  
>     Attributes
>     ----------
>     length : float
>         Axial length L [mm].
>     diameter : float
>         Outer diameter d [mm].
>     inner_diameter : float
>         Inner diameter d_i [mm]; 0.0 for solid sections.
>     material_id : str
>         Reference to the material library (core/materials.py).
>     surface_finish_ra : float
>         Arithmetic mean roughness Ra [μm]; used to compute Marin factor ka.
>     shoulder_left : Shoulder | None
>         Geometry of the transition on the left (datum) side.
>     shoulder_right : Shoulder | None
>         Geometry of the transition on the right side.
>     label : str
>         Optional human-readable identifier.
  
>     Geometric properties (all @property):
>         radius                [mm]
>         area                  [mm²]
>         second_moment_of_area I [mm⁴]
>         polar_moment          J [mm⁴]
>         section_modulus       W = I / (d/2) [mm³]
>         polar_section_modulus Wt = J / (d/2) [mm³]
>     """
>     length: float
>     diameter: float
>     inner_diameter: float = 0.0
>     material_id: str = "S355"
>     surface_finish_ra: float = 0.8   # Ra [μm] — typical turned finish
>     shoulder_left: Optional[Shoulder] = None
>     shoulder_right: Optional[Shoulder] = None
>     label: str = ""
  
>     def __post_init__(self) -> None:
>         if self.length <= 0:
>             raise ValueError(
>                 f"ShaftSection length must be > 0, got {self.length}"
>             )
>         if self.diameter <= 0:
>             raise ValueError(
>                 f"ShaftSection diameter must be > 0, got {self.diameter}"
>             )
>         if self.inner_diameter < 0:
>             raise ValueError(
>                 f"inner_diameter cannot be negative, got {self.inner_diameter}"
>             )
>         if self.inner_diameter >= self.diameter:
>             raise ValueError(
>                 f"inner_diameter ({self.inner_diameter}) must be < "
>                 f"outer diameter ({self.diameter})"
>             )
>         if self.surface_finish_ra <= 0:
>             raise ValueError(
>                 f"surface_finish_ra must be > 0, got {self.surface_finish_ra}"
>             )
  
      # ------------------------------------------------------------------
      # Derived geometric properties
      # ------------------------------------------------------------------
  
>     @property
>     def is_hollow(self) -> bool:
>         """True if inner_diameter > 0."""
>         return self.inner_diameter > 0.0
  
>     @property
>     def radius(self) -> float:
>         """Outer radius [mm]."""
>         return self.diameter / 2.0
  
>     @property
>     def area(self) -> float:
>         """Cross-sectional area A [mm²]."""
>         return (math.pi / 4.0) * (self.diameter**2 - self.inner_diameter**2)
  
>     @property
>     def second_moment_of_area(self) -> float:
>         """
>         Second moment of area I [mm⁴] about any diameter axis.
>         I = π/64 × (d⁴ − dᵢ⁴)
>         """
>         return (math.pi / 64.0) * (self.diameter**4 - self.inner_diameter**4)
  
>     @property
>     def polar_moment(self) -> float:
>         """
>         Polar moment of area J [mm⁴].
>         J = π/32 × (d⁴ − dᵢ⁴) = 2I
>         """
>         return (math.pi / 32.0) * (self.diameter**4 - self.inner_diameter**4)
  
>     @property
>     def section_modulus(self) -> float:
>         """
>         Bending section modulus W = I / (d/2) [mm³].
>         σ_b = M / W
>         """
>         return self.second_moment_of_area / (self.diameter / 2.0)
  
>     @property
>     def polar_section_modulus(self) -> float:
>         """
>         Polar section modulus Wt = J / (d/2) [mm³].
>         τ = T / Wt
>         """
>         return self.polar_moment / (self.diameter / 2.0)
  
>     def validate(self) -> list[str]:
>         """Return list of geometry errors (empty if valid)."""
>         errors: list[str] = []
>         if self.length <= 0:
!             errors.append(f"length must be > 0 (got {self.length})")
>         if self.diameter <= 0:
!             errors.append(f"diameter must be > 0 (got {self.diameter})")
>         if self.inner_diameter < 0:
!             errors.append(f"inner_diameter cannot be negative (got {self.inner_diameter})")
>         if self.inner_diameter >= self.diameter:
!             errors.append(
!                 f"inner_diameter ({self.inner_diameter}) must be < diameter ({self.diameter})"
!             )
>         if self.shoulder_left is not None:
>             errors.extend(
>                 [f"shoulder_left: {e}" for e in self.shoulder_left.validate()]
>             )
>         if self.shoulder_right is not None:
>             errors.extend(
>                 [f"shoulder_right: {e}" for e in self.shoulder_right.validate()]
>             )
>         return errors
  
  
  # ---------------------------------------------------------------------------
  # Shaft
  # ---------------------------------------------------------------------------
  
> @dataclass
> class Shaft:
>     """
>     Ordered sequence of ShaftSection objects representing a complete shaft.
  
>     Axial coordinate convention:
>       - Datum (x = 0) is the left face of sections[0].
>       - Sections are appended left-to-right; sections[-1] ends at total_length.
>       - All component positions (bearings, gears, loads) use this coordinate.
  
>     Boundary rule for section_at(x):
>       - Interior boundaries belong to the RIGHT section (right-hand rule).
>       - x = 0 → section 0; x = total_length → last section.
  
>     Methods:
>         add_section(section)    — append a section
>         total_length            — sum of all section lengths [mm]
>         n_sections              — number of sections
>         axial_start(index)      — absolute start position of section[index] [mm]
>         axial_end(index)        — absolute end position of section[index] [mm]
>         section_at(x)           — (ShaftSection, index) containing position x
>         diameter_at(x)          — outer diameter at x [mm]
>         I_at(x)                 — second moment of area at x [mm⁴]
>         J_at(x)                 — polar moment at x [mm⁴]
>         W_at(x)                 — bending section modulus at x [mm³]
>         Wt_at(x)                — polar section modulus at x [mm³]
>         shoulders()             — list of (x_position, Shoulder) for all shoulders
>         validate()              — list of geometry errors
>         validate_or_raise()     — raise ValueError if invalid
>     """
>     sections: list[ShaftSection] = field(default_factory=list)
>     name: str = "Shaft_1"
  
>     def add_section(self, section: ShaftSection) -> None:
>         """Append a section to the right end of the shaft."""
>         if not isinstance(section, ShaftSection):
>             raise TypeError(f"Expected ShaftSection, got {type(section)}")
>         self.sections.append(section)
  
>     @property
>     def total_length(self) -> float:
>         """Total axial length of the shaft [mm]."""
>         return sum(s.length for s in self.sections)
  
>     @property
>     def n_sections(self) -> int:
>         """Number of sections."""
>         return len(self.sections)
  
>     def axial_start(self, index: int) -> float:
>         """
>         Absolute axial position of the start face of sections[index] [mm].
  
>         Parameters
>         ----------
>         index : int
>             Section index (0-based).
  
>         Raises
>         ------
>         IndexError
>             If index is out of range.
>         """
>         if index < 0 or index >= len(self.sections):
>             raise IndexError(
>                 f"Section index {index} out of range "
>                 f"(shaft has {len(self.sections)} sections)"
>             )
>         return sum(self.sections[i].length for i in range(index))
  
>     def axial_end(self, index: int) -> float:
>         """
>         Absolute axial position of the end face of sections[index] [mm].
  
>         Parameters
>         ----------
>         index : int
>             Section index (0-based).
  
>         Raises
>         ------
>         IndexError
>             If index is out of range.
>         """
>         if index < 0 or index >= len(self.sections):
>             raise IndexError(
>                 f"Section index {index} out of range "
>                 f"(shaft has {len(self.sections)} sections)"
>             )
>         return sum(self.sections[i].length for i in range(index + 1))
  
>     def section_at(self, x: float) -> tuple[ShaftSection, int]:
>         """
>         Return the (ShaftSection, index) that contains axial coordinate x.
  
>         Boundary rule: interior boundaries belong to the RIGHT section.
>           - [0, L₀)       → section 0
>           - [L₀, L₀+L₁)   → section 1
>           - ...
>           - [Lₙ₋₁, L_total] → last section (inclusive at right end)
  
>         Parameters
>         ----------
>         x : float
>             Axial coordinate [mm].
  
>         Raises
>         ------
>         ValueError
>             If x is outside [0, total_length].
>         """
>         L = self.total_length
>         if x < -TOL_GEOMETRY_mm or x > L + TOL_GEOMETRY_mm:
>             raise ValueError(
>                 f"x={x:.4f} mm is outside shaft extent "
>                 f"[0, {L:.4f}] mm"
>             )
          # Clamp to valid range (handles floating-point boundary cases)
>         x = max(0.0, min(x, L))
  
>         cumulative = 0.0
>         for i, section in enumerate(self.sections):
>             next_cumulative = cumulative + section.length
              # Right-hand rule: boundary belongs to the right section.
              # Use strict < so the boundary point goes to the next iteration.
              # Last section is always returned for x <= total_length.
>             if x < next_cumulative - TOL_GEOMETRY_mm or i == len(self.sections) - 1:
>                 return section, i
>             cumulative = next_cumulative
  
          # Should never reach here after clamping
!         return self.sections[-1], len(self.sections) - 1
  
>     def diameter_at(self, x: float) -> float:
>         """Outer diameter at axial position x [mm]."""
>         section, _ = self.section_at(x)
>         return section.diameter
  
>     def I_at(self, x: float) -> float:
>         """Second moment of area I(x) [mm⁴]."""
>         section, _ = self.section_at(x)
>         return section.second_moment_of_area
  
>     def J_at(self, x: float) -> float:
>         """Polar moment of area J(x) [mm⁴]."""
>         section, _ = self.section_at(x)
>         return section.polar_moment
  
>     def W_at(self, x: float) -> float:
>         """Bending section modulus W(x) = I(x) / r(x) [mm³]."""
>         section, _ = self.section_at(x)
>         return section.section_modulus
  
>     def Wt_at(self, x: float) -> float:
>         """Polar section modulus Wt(x) = J(x) / r(x) [mm³]."""
>         section, _ = self.section_at(x)
>         return section.polar_section_modulus
  
>     def shoulders(self) -> list[tuple[float, Shoulder]]:
>         """
>         Return list of (x_position, Shoulder) for all shoulders in the shaft.
  
>         Only shoulder_right of each section is reported, at the section's
>         right-end boundary position. This avoids double-counting the same
>         physical shoulder from both adjacent sections.
  
>         Returns
>         -------
>         list of (float, Shoulder)
>             Sorted by ascending axial position.
>         """
>         result: list[tuple[float, Shoulder]] = []
>         cumulative = 0.0
>         for section in self.sections:
>             cumulative += section.length
>             if section.shoulder_right is not None:
>                 result.append((cumulative, section.shoulder_right))
>         return result
  
>     def validate(self) -> list[str]:
>         """
>         Return list of geometry errors.
>         An empty list means the shaft is geometrically valid.
>         """
>         errors: list[str] = []
  
>         if not self.sections:
>             errors.append("Shaft has no sections")
>             return errors  # nothing more to check
  
>         for i, s in enumerate(self.sections):
>             section_errors = s.validate()
>             errors.extend(
>                 [f"Section {i} ({s.label!r}): {e}" for e in section_errors]
>             )
  
          # Consistency: adjacent shoulder diameters must match section diameters
>         for i in range(len(self.sections) - 1):
>             left = self.sections[i]
>             right = self.sections[i + 1]
              # shoulder_right of section i describes the step from i → i+1
>             if left.shoulder_right is not None:
>                 d_small = left.shoulder_right.diameter_small
>                 d_next = right.diameter
>                 if abs(d_small - d_next) > TOL_GEOMETRY_mm:
>                     errors.append(
>                         f"Shoulder mismatch at boundary {i}/{i+1}: "
>                         f"shoulder_right.diameter_small={d_small:.4f} mm "
>                         f"≠ section[{i+1}].diameter={d_next:.4f} mm"
>                     )
              # shoulder_left of section i+1 must match the step from i → i+1
>             if right.shoulder_left is not None:
>                 d_small = right.shoulder_left.diameter_small
>                 d_prev = left.diameter
>                 if abs(d_small - d_prev) > TOL_GEOMETRY_mm:
>                     errors.append(
>                         f"Shoulder mismatch at boundary {i}/{i+1}: "
>                         f"section[{i+1}].shoulder_left.diameter_small={d_small:.4f} mm "
>                         f"≠ section[{i}].diameter={d_prev:.4f} mm"
>                     )
  
>         return errors
  
>     def validate_or_raise(self) -> None:
>         """Raise ValueError if shaft geometry is invalid."""
>         errors = self.validate()
>         if errors:
>             raise ValueError(
>                 "Shaft validation failed:\n"
>                 + "\n".join(f"  - {e}" for e in errors)
>             )
  
>     def __len__(self) -> int:
>         return len(self.sections)
  
>     def __repr__(self) -> str:
>         return (
>             f"Shaft(name={self.name!r}, "
>             f"sections={len(self.sections)}, "
>             f"total_length={self.total_length:.1f} mm)"
>         )
