> """
> core/system.py
> MechanicalSystem — top-level container passed to all solvers.
  
> Responsibilities:
>   - Hold shaft geometry, bearings, gear elements, and point loads.
>   - Enforce basic structural constraints (≥ 2 supports).
>   - Validate that all components lie within shaft bounds.
>   - Provide sorted, consistent access to components.
  
> Solvers receive a MechanicalSystem and return result dataclasses.
> MechanicalSystem itself performs NO calculations.
> """
  
> from __future__ import annotations
> from dataclasses import dataclass, field
> from typing import TYPE_CHECKING
  
> from .shaft import Shaft
> from .components import Bearing, GearElement
> from .loads import Load, RadialLoad, AxialLoad, TorqueLoad, ExternalMoment
> from config import DEFAULT_DESIGN_LIFE_HOURS
  
  
> @dataclass
> class MechanicalSystem:
>     """
>     Single-shaft mechanical system assembly.
  
>     Parameters
>     ----------
>     shaft : Shaft
>         Shaft geometry. Must have at least one section.
>     name : str
>         Identifier for logging and reports.
>     speed_rpm : float
>         Operating rotational speed [rpm]. Required for bearing life (L10h).
>     design_life_hours : float
>         Target bearing life [h]. Default from config.
  
>     Internal lists are sorted by position on every access via properties.
>     """
>     shaft: Shaft
>     name: str = "System_1"
>     speed_rpm: float = 0.0
>     design_life_hours: float = DEFAULT_DESIGN_LIFE_HOURS
  
>     _bearings: list[Bearing] = field(default_factory=list, repr=False)
>     _gears: list[GearElement] = field(default_factory=list, repr=False)
>     _loads: list[Load] = field(default_factory=list, repr=False)
  
      # ------------------------------------------------------------------
      # Mutators
      # ------------------------------------------------------------------
  
>     def add_bearing(self, bearing: Bearing) -> None:
>         """
>         Register a bearing support.
  
>         Raises
>         ------
>         ValueError
>             If bearing position is outside the shaft.
>         """
>         L = self.shaft.total_length
>         if bearing.position < 0 or bearing.position > L + 1e-6:
>             raise ValueError(
>                 f"Bearing '{bearing.label}' at x = {bearing.position:.3f} mm "
>                 f"is outside shaft (0 – {L:.3f} mm)"
>             )
>         self._bearings.append(bearing)
  
>     def add_gear(self, gear: GearElement) -> None:
>         """
>         Register a gear element.
  
>         Raises
>         ------
>         ValueError
>             If gear position is outside the shaft.
>         """
>         L = self.shaft.total_length
>         if gear.position < 0 or gear.position > L + 1e-6:
>             raise ValueError(
>                 f"GearElement '{gear.label}' at x = {gear.position:.3f} mm "
>                 f"is outside shaft (0 – {L:.3f} mm)"
>             )
>         self._gears.append(gear)
  
>     def add_load(self, load: Load) -> None:
>         """
>         Register a point load or moment.
  
>         Position is not validated against shaft bounds here (loads may act at
>         overhanging positions conceptually). Validation is done in validate().
>         """
>         self._loads.append(load)
  
      # ------------------------------------------------------------------
      # Sorted accessors
      # ------------------------------------------------------------------
  
>     @property
>     def bearings(self) -> list[Bearing]:
>         """Bearings sorted by axial position (left → right)."""
>         return sorted(self._bearings, key=lambda b: b.position)
  
>     @property
>     def gears(self) -> list[GearElement]:
>         """Gear elements sorted by axial position."""
>         return sorted(self._gears, key=lambda g: g.position)
  
>     @property
>     def loads(self) -> list[Load]:
>         """All point loads/moments (insertion order preserved)."""
>         return list(self._loads)
  
>     @property
>     def support_positions(self) -> list[float]:
>         """Sorted axial positions of all bearing supports [mm]."""
>         return [b.position for b in self.bearings]
  
      # ------------------------------------------------------------------
      # Convenience queries
      # ------------------------------------------------------------------
  
>     @property
>     def radial_loads_xz(self) -> list[RadialLoad]:
>         from .loads import LoadPlane
>         return [
>             l for l in self._loads
>             if isinstance(l, RadialLoad) and l.plane == LoadPlane.XZ
>         ]
  
>     @property
>     def radial_loads_yz(self) -> list[RadialLoad]:
>         from .loads import LoadPlane
>         return [
>             l for l in self._loads
>             if isinstance(l, RadialLoad) and l.plane == LoadPlane.YZ
>         ]
  
>     @property
>     def axial_loads(self) -> list[AxialLoad]:
>         return [l for l in self._loads if isinstance(l, AxialLoad)]
  
>     @property
>     def torque_loads(self) -> list[TorqueLoad]:
>         return [l for l in self._loads if isinstance(l, TorqueLoad)]
  
>     @property
>     def external_moments(self) -> list[ExternalMoment]:
>         return [l for l in self._loads if isinstance(l, ExternalMoment)]
  
      # ------------------------------------------------------------------
      # Validation
      # ------------------------------------------------------------------
  
>     def validate(self) -> list[str]:
>         """
>         Return list of all structural/consistency errors.
  
>         Does not raise — callers decide how to handle errors.
>         Call validate_or_raise() for solver entry points.
>         """
>         errors: list[str] = []
  
          # Shaft geometry
>         errors.extend(self.shaft.validate())
  
          # Minimum support constraint
>         if len(self._bearings) < 2:
>             errors.append(
>                 f"System requires ≥ 2 bearing supports, "
>                 f"got {len(self._bearings)}"
>             )
  
          # Speed for life calculations
>         if self.speed_rpm < 0:
>             errors.append(f"speed_rpm cannot be negative, got {self.speed_rpm}")
  
>         L = self.shaft.total_length
  
          # Component position bounds
>         for b in self._bearings:
>             if b.position < 0 or b.position > L + 1e-6:
>                 errors.append(
>                     f"Bearing '{b.label}' at x = {b.position:.3f} mm "
>                     f"is outside shaft (0 – {L:.3f} mm)"
>                 )
  
>         for g in self._gears:
>             if g.position < 0 or g.position > L + 1e-6:
>                 errors.append(
>                     f"GearElement '{g.label}' at x = {g.position:.3f} mm "
>                     f"is outside shaft (0 – {L:.3f} mm)"
>                 )
  
          # Warn if two bearings at identical position (zero span)
>         positions = self.support_positions
>         if len(positions) >= 2:
>             for i in range(len(positions) - 1):
>                 if abs(positions[i] - positions[i + 1]) < 1e-3:
>                     errors.append(
>                         f"Bearings at positions {positions[i]:.3f} and "
>                         f"{positions[i+1]:.3f} mm are effectively at the same "
>                         f"location (span < 0.001 mm) — solver will divide by zero"
>                     )
  
>         return errors
  
>     def validate_or_raise(self) -> None:
>         """
>         Run validation and raise ValueError if any errors are found.
  
>         Call this at the entry point of every solver.
>         """
>         errors = self.validate()
>         if errors:
>             raise ValueError(
>                 "MechanicalSystem validation failed:\n"
>                 + "\n".join(f"  - {e}" for e in errors)
>             )
  
>     def summary(self) -> str:
>         """One-line summary for CLI / logging output."""
>         return (
>             f"{self.name}: shaft {self.shaft.total_length:.1f} mm, "
>             f"{len(self._bearings)} bearings, "
>             f"{len(self._gears)} gears, "
>             f"{len(self._loads)} loads, "
>             f"{self.speed_rpm:.0f} rpm"
>         )
  
>     def __repr__(self) -> str:
>         return (
>             f"MechanicalSystem(name={self.name!r}, "
>             f"speed_rpm={self.speed_rpm}, "
>             f"bearings={len(self._bearings)}, "
>             f"gears={len(self._gears)}, "
>             f"loads={len(self._loads)})"
>         )
